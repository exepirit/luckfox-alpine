# Contributor: exepirit <exepir1t@protonmail.com>
# Maintainer: exepirit <exepir1t@protonmail.com>
pkgname=rnode
_commit="4e6b6a806bf1a9417fcc57d5d6e392deacca43f2"
pkgver=0_git20260313
pkgrel=1
pkgdesc="Implementation of RNode functionality for Linux based on SX126x LoRa modules"
url="https://github.com/exepirit/RNode-linux"
arch="all"
license="LGPL-2.1-or-later"
depends="libgpiod libcyaml"
makedepends="cmake samurai linux-headers libgpiod-dev libcyaml-dev"
options="!check" # no tests
source="rnode-$_commit.tar.gz::https://github.com/exepirit/RNode-linux/archive/$_commit.tar.gz
	rnode.initd
	rnode.confd"
builddir="$srcdir/RNode-linux-$_commit"

build() {
	if [ "$CBUILD" != "$CHOST" ]; then
                local crossopts="-DCMAKE_SYSTEM_NAME=Linux -DCMAKE_HOST_SYSTEM_NAME=Linux"
        fi
        cmake -B build \
                -DCMAKE_INSTALL_PREFIX=/usr \
                -DCMAKE_BUILD_TYPE=Release \
                $crossopts
        cmake --build build
}

package() {
	install -d "$pkgdir"/usr/bin "$pkgdir"/etc
	install -m755 "$builddir"/build/rnode "$pkgdir"/usr/bin/rnode
	install -m644 "$builddir"/rnode.yaml "$pkgdir"/etc/rnode.yaml

	# init script
	install -d "$pkgdir"/etc/init.d "$pkgdir"/etc/conf.d
	install -m755 "$srcdir"/rnode.initd "$pkgdir"/etc/init.d/rnode
	install -m644 "$srcdir"/rnode.confd "$pkgdir"/etc/conf.d/rnode
}


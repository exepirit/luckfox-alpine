# Contributor:
# Maintainer:
pkgname=libcyaml
pkgver=1.4.2
pkgrel=0
pkgdesc="Schema-based YAML parsing and serialisation"
url="https://github.com/tlsa/libcyaml"
arch="all"
license="ISC"
makedepends="yaml-dev"
subpackages="$pkgname-dev"
source="libcyaml-$pkgver.tar.gz::https://github.com/tlsa/libcyaml/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/libcyaml-$pkgver"

build() {
	make
}

check() {
	make test
}

package() {
	make PREFIX=/usr DESTDIR="$pkgdir" install
	install -Dm644 docs/guide.md -t "$pkgdir"/usr/share/doc/"$pkgname-dev"/
	install -Dm644 examples/numerical/* -t "$pkgdir"/usr/share/doc/"$pkgname-dev"/examples/numerical/
	install -Dm644 examples/planner/* -t "$pkgdir"/usr/share/doc/"$pkgname-dev"/examples/planner/
	install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/"$pkgname"/
}

sha512sums="

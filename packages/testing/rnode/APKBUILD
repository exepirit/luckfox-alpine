# Contributor:
# Maintainer:
pkgname=rnode
pkgver="0.0.0"
pkgrel=0
pkgdesc="Implementation of RNode functionality for Linux based on SPI sx126x modules"
url="https://github.com/strijar/RNode-linux"
license="custom"
arch="all"
depends="libgpiod libcyaml"
makedepends="cmake samurai libgpiod-dev libcyaml-dev linux-headers"

_commit="878840f141a624880bf2f04a1d9e9556c5ddbfb7"
source="https://github.com/strijar/RNode-linux/archive/$_commit.tar.gz"
builddir="$srcdir/RNode-linux-$_commit"

build() {
	if [ "$CBUILD" != "$CHOST" ]; then
		local crossopts="-DCMAKE_SYSTEM_NAME=Linux -DCMAKE_HOST_SYSTEM_NAME=Linux"
	fi
	cmake -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DBUILD_SHARED_LIBS=ON \
		-DCMAKE_BUILD_TYPE=None \
		$crossopts
	cmake --build build
}

check() {
	ctest --test-dir build --output-on-failure
}

package() {
	install -Dm755 build/rnode "$pkgdir"/usr/bin/rnode
	install -Dm644 rnode.yaml "$pkgdir"/etc/rnode.yaml
}

sha512sums="
